# Copy concepts into your host's environment settings.
# Do not create a local .env in this workspace — the platform injects secrets.
# Never commit real values. Never prefix secrets with VITE_.

# Required in production so block, report, and rate-limit hashes cannot be
# forged or reversed. Use a long random string (32+ bytes).
APP_SECRET=

# Public site origin used in email links. Example: https://alittlebird.com
APP_URL=https://alittlebird.com

# Transactional email (Resend). When RESEND_API_KEY is unset, sends are
# accepted in preview mode and no email is transmitted.
RESEND_API_KEY=
EMAIL_FROM=a little bird <bird@alittlebird.com>
EMAIL_REPLY_TO=noreply@alittlebird.com

# Resend (Svix) webhook signing secret for bounce and complaint events.
RESEND_WEBHOOK_SECRET=

# Cloudflare Turnstile. Set BOTH. The site key is public; the secret is not.
# Only the site key may use a VITE_ prefix, because it must reach the browser.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Postgres is injected as DATABASE_URL on deploy. Do not put it here.
# Local preview uses embedded Postgres automatically.
